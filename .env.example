# ==========================================================================
# Supabase -> Project Settings > Database (usa el POOLER, IPv4)
# DATABASE_URL: Transaction pooler (6543) + ?pgbouncer=true  -> runtime
# DIRECT_URL  : Session pooler (5432)                        -> migraciones
# ==========================================================================
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================================================
# Supabase -> Project Settings > API  (públicas, van al navegador)
# ==========================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-PUBLIC-KEY]"

# ==========================================================================
# Cloudinary -> imágenes de las tareas. El SECRET va SOLO en el servidor.
# ==========================================================================
CLOUDINARY_CLOUD_NAME="[CLOUD-NAME]"
CLOUDINARY_API_KEY="[API-KEY]"
CLOUDINARY_API_SECRET="[API-SECRET]"
